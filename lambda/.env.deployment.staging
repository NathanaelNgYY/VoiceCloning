ARTIFACT_SOURCE=s3
# lectures.lkcmedicine.org is the alias students actually visit; the browser
# sends it as `Origin`, so it must be listed literally alongside the CloudFront
# hostname that still serves the other staging builds.
CORS_ORIGIN=https://d1qh0ebsvevhy3.cloudfront.net,https://dfzrfr93t2ruf.cloudfront.net,https://d25sg72wp8oj5g.cloudfront.net,https://lectures.lkcmedicine.org
# Bearer-token check on the /api/live synthesis routes. The gateway
# authenticates the conversation; this closes the other door, so signing in to
# the socket does not leave /api/live/tts-sentence open to direct calls that
# spend GPU time. Must match the gateway's values exactly — same tenant, same
# api:// audience — because one token has to satisfy both.
LIVE_AUTH_ENABLED=true
# NTU's tenant, not the 45e82b6b-… directory the app is registered in. Must stay
# identical to the gateway's value: one token has to satisfy both.
ENTRA_TENANT_ID=15ce9348-be2a-462b-8fc0-e1765a9b204a
# Bare client ID: ID tokens, not access tokens. Must match the gateway exactly —
# one token has to satisfy both.
ENTRA_AUDIENCE=9b5c52c0-5f02-4dbf-83ac-c68d246abc68
ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,student.main.ntu.edu.sg,assoc.main.ntu.edu.sg
# CloudFront stamps X-VCS-Site=faculty on the faculty distribution. Its API
# accepts only staff and associate accounts even though lectures also permits
# student accounts.
FACULTY_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,assoc.main.ntu.edu.sg
# Empty disables the load-test bypass. Set it to the same value as the gateway's
# LIVE_AUTH_LOADTEST_SECRET for a rehearsal, and clear it afterwards.
LIVE_AUTH_LOADTEST_SECRET=
GPU_IDLE_STOP_MINUTES=30
GPU_INSTANCE_ID=i-0f0da8be59367f7a8
GPU_INSTANCE_REGION=ap-northeast-2
GPU_WORKER_PUBLIC_URL=https://dfzrfr93t2ruf.cloudfront.net
GPU_WORKER_URL=http://voice-gpu-alb-staging-1031778835.ap-northeast-2.elb.amazonaws.com
GPU_STATUS_READINESS_TARGET=inference
MODEL_SOURCE=s3
S3_BUCKET=interns2026-small-projects-bucket-shared
S3_PREFIX=echolect-staging/
S3_REGION=ap-southeast-1
LIVE_AUTH_EXEMPT_ORIGINS=

# Who counts as a developer/supervisor: sees learner analytics, and every
# lecturer's voice rather than only their own. Entra object ids, matching the
# non-staging function's list — cs-tengyu.liu@ and cs-nathanael.ng@. An oid is
# stable per user per tenant, so the same values identify them in both stacks.
SUPERVISOR_APP_ROLE=Supervisor
SUPERVISOR_OIDS=439b6915-f696-415c-b144-3c0f0d06c120,31e46d84-542c-4414-bcc0-1c7c24023198

# Standard (ElevenLabs) voices offered alongside each lecturer's own cloned
# voice. Feature-detected: with no API key set, the faculty panel simply shows
# no standard voices and everything else is unchanged.
#
# ELEVENLABS_API_KEY IS DELIBERATELY NOT LISTED HERE. This file is tracked in
# git, and the key is account-wide and billable. Set it directly on the Lambda:
#   aws lambda update-function-configuration --region ap-northeast-2 \
#     --function-name Liu_Teng_Yu_Intern2026-Voice_Cloning_Project-staging ...
# or in the console. deploy-lambda.ps1 reads the live config and merges this
# file over it, so a key set that way survives every later deploy.
#
# ~75ms time-to-first-byte and the cheapest per character, which is what a
# per-sentence chat reply wants. eleven_multilingual_v2 trades latency for
# quality; eleven_v3_conversational is the expressive middle ground.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# mp3 is the only format family with no subscription-tier restriction — 44.1kHz
# WAV/PCM needs Pro. The browser follows the response's own content-type.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# The shortlist lecturers see, as comma-separated voice ids. Each id is resolved
# individually against /v1/voices/{id}, so any voice can be named here — premade,
# community, or cloned on the account. Empty falls back to the ~21 premade
# voices (NOT the ~400-voice community library, which is unusable in a dropdown).
#
# This MUST stay populated: deploy-lambda.ps1 merges this file over the live
# config, so blanking it here silently wipes the shortlist on the next deploy.
# Voice ids are public identifiers, not secrets — unlike the API key above.
#
# Alice (F, british, educator) · Daniel (M, british, broadcaster)
# Bella (F, american, professional) · Eric (M, american, trustworthy)
# River (neutral, american, informative) · Matilda (F, american, professional)
ELEVENLABS_VOICE_IDS=Xb7hH8MSUJpSbSDYk0k2,onwK4e9ZLuTAKqWW03F9,hpp4J3VqNfWAUOO0d1Us,cjVigY5qzO86Huf0OWal,SAz9YHcvj6GT2YYXdXww,XrExE9yKIg1WjnnlVkGX
# Per-request character cap. Billing is per character and a chat reply is
# synthesised one sentence at a time, so anything longer is a sentence-splitting
# failure rather than a real sentence.
ELEVENLABS_MAX_CHARS=800
