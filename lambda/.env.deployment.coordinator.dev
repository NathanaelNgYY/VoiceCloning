# Dev uses the same coordinator code and routing decisions as Staging, but it
# never starts, stops, or scales instances. Only manually running instances in
# this explicit list participate in routing. Capacity pressure is returned as a
# simulation message describing what Staging would have requested.
MODEL_COORDINATOR_MODE=routing-only
# The deployment role cannot create DynamoDB tables. Sharing the lease table is
# safe here because routing-only fleet discovery filters to the explicit Dev
# instance IDs, and reassignment records are keyed by those unique IDs.
MODEL_COORDINATOR_TABLE=vcs-staging-model-workers
MODEL_COORDINATOR_INSTANCE_IDS=i-03f258d470a2fa73f,i-0048470294e4ec518
MODEL_REASSIGN_IDLE_MS=0
MODEL_BOOT_ESTIMATE_SECONDS=60
