# Environment for the MODEL COORDINATOR function (…-staging-coordinator), which
# is a separate Lambda from the router and therefore has its own file. Applied by
# scripts/deploy-lambda.ps1, which merges these over the function's live config so
# console-set secrets survive — same rule as .env.deployment.staging, so no keys
# here either.

MODEL_COORDINATOR_MODE=autoscale
MODEL_COORDINATOR_SCOPE=staging

# How long the coordinator tells a caller to wait while it brings a GPU to their
# voice. It is the source of BOTH the HTTP Retry-After header and the wait the
# browser shows ("This usually takes about 10 minutes"), so the two can never
# disagree — see capacityWaitMessage() in client/src/lib/backendErrors.js.
# Measured warm-up on staging is ~10 minutes. The code default is 360, so leaving
# this unset silently under-promises by four minutes.
MODEL_BOOT_ESTIMATE_SECONDS=600

# Reuse an idle GPU immediately when a sequential request selects another
# model. Additional instances are for overlapping active/queued work only.
MODEL_REASSIGN_IDLE_MS=0
MODEL_PREFLIGHT_REASSIGN_IDLE_MS=30000

# Bounded, distributed overflow waiting. Each matching GPU accepts at most this
# many waiting requests; the coordinator picks the least-loaded GPU first so a
# burst spreads across the fleet. Beyond the ceiling the caller retries against
# the growing fleet instead of queueing without limit. The worker's own
# SYNTHESIS_MAX_QUEUE_DEPTH (100) is deliberately looser, so this is the real bound.
MODEL_MAX_QUEUED_PER_WORKER=2
