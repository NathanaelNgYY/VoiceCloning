NODE_ENV=production
PORT=3002
CORS_ORIGIN=https://d1qh0ebsvevhy3.cloudfront.net,https://dfzrfr93t2ruf.cloudfront.net,https://d25sg72wp8oj5g.cloudfront.net
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VAD=semantic_vad
OPENAI_REALTIME_SYSTEM_PROMPT="You are a casual, helpful assistant. Keep replies concise and conversational. Always respond only in English."

# --- Live-chat identity -------------------------------------------------------
# Turning this on makes session.auth the first frame the socket must receive.
# Only the gi client sends one, so enabling it here without shipping a gi build
# that has VITE_API_AUTH_MODE=entra closes every connection with 4401.
LIVE_AUTH_ENABLED=true
# NTU's tenant — the directory the student actually authenticates against, which
# is NOT the 45e82b6b-… "Default Directory" the app is registered in. The client
# uses the /common authority, so this is the only place the tenant is pinned:
# entraToken.js builds the issuer and the JWKS URL from it and rejects any token
# whose `tid` differs. Pointing it at the registration's own tenant instead is
# what produced AADSTS50020 — no NTU account exists there.
ENTRA_TENANT_ID=15ce9348-be2a-462b-8fc0-e1765a9b204a
# The bare client ID, because this deployment verifies ID tokens, whose `aud` is
# the app itself. The api://<clientId> form belongs to the access-token route and
# is rejected here — one or the other, never both.
#
# The access-token route is the textbook answer and needs `access_as_user`
# exposed on the registration. That is portal work nobody could get: as of
# 2026-08-05 the scope still does not exist (AADSTS65005), and asking for it
# fails the *login*, not just the API call. ID tokens need no portal work.
#
# This still narrows to one application. Without the check any Entra-signed
# token from any app in the tenant would pass.
ENTRA_AUDIENCE=9b5c52c0-5f02-4dbf-83ac-c68d246abc68
# Empty would admit every account in the NTU tenant, so readinessProblems()
# reports an empty value as a config error rather than a deliberate choice.
ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,student.main.ntu.edu.sg,assoc.main.ntu.edu.sg
# Load tests have no interactive sign-in. Deliberately a second credential rather
# than a flag that disables auth: there is no single setting that opens the
# gateway, and synthetic sessions stay identifiable (oid LOADTEST#<n>).
# Empty disables the bypass entirely — set it only for a rehearsal, and give the
# same value to the load test as VCS_CHATBOT_LOADTEST_SECRET.
LIVE_AUTH_LOADTEST_SECRET=

# --- Transcript storage -------------------------------------------------------
# Empty table name disables storage completely. Writes happen only on
# authenticated sessions, so this and LIVE_AUTH_ENABLED go together.
TRANSCRIPT_TABLE_NAME=vcs-staging-transcripts
# Next to the gateway EC2 host. Note the standing split: the shared S3 bucket is
# ap-southeast-1, this is not.
TRANSCRIPT_TABLE_REGION=ap-northeast-2
# 90 days on identifiable rows; the de-identified export carries the long-term
# research use instead. 0 would write no ttl attribute and nothing would expire.
TRANSCRIPT_TTL_DAYS=90
# Keeps rehearsal traffic out of the table.
TRANSCRIPT_STORE_SYNTHETIC=false

GEMINI_API_KEY=***REMOVED***
