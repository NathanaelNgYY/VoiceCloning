# Dev override for the gi (GI-bleeding lesson) build — the d2o0cbe2zunqkr
# distribution, S3 prefix echolect/dist-gi.
#
# deploy-client.ps1 maps `-Mode chatbot` through `chatbotBuildMode: "gi"`, then
# copies this file to client/.env.gi.local before running `npm run build:gi`.
#
# This file did not exist until now, and its absence was silent: deploy-client.ps1
# only copies an override when Test-Path finds one,
# so `-Env dev -Mode chatbot` built and deployed happily with no override at all
# and fell back to client/.env.gi. That build has no VITE_AUTH_MODE and no
# VITE_ENTRA_* block, so dev shipped an unauthenticated site with no sign-in page
# — while the dev backends have required Entra tokens the whole time
# (LIVE_AUTH_ENABLED=true in both lambda/.env.deployment and
# live-gateway/.env.livegateway.deployment). Keep this file in place or dev
# quietly reverts to that split.
#
# The staging counterpart (client/env/staging/gi.env) carries the long-form
# reasoning for every Entra value below; only the dev-specific deltas are
# explained here.
VITE_APP_MODE=gi
VITE_APP_BASENAME=/

# Matches staging so dev exercises the same sign-in path students hit.
VITE_GI_AUTH_ENABLED=true
VITE_AUTH_MODE=msal

# The same multi-tenant "GI Bleeding" app registration staging uses — there is
# only one, and both environments' backends already pin ENTRA_AUDIENCE to this
# exact client ID.
#
# REQUIRES an Azure-side change that is NOT in this repo: https://d2o0cbe2zunqkr.cloudfront.net
# must be listed as an *SPA* redirect URI on this registration. MSAL redeems
# against the exact origin the browser was on, so the staging entries do not
# cover dev. Missing it fails sign-in; adding it under "Web" instead of "SPA"
# fails at token redemption with AADSTS9002326.
VITE_ENTRA_CLIENT_ID=9b5c52c0-5f02-4dbf-83ac-c68d246abc68

# /common, not a pinned tenant — the registration lives outside NTU's directory,
# so pinning it authenticates against a directory with no NTU accounts
# (AADSTS50020). The dev gateway and Lambda still reject any token whose tid is
# not NTU's 15ce9348-…, so this does not widen access.
VITE_ENTRA_TENANT_AUTHORITY=https://login.microsoftonline.com/common

VITE_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,student.main.ntu.edu.sg,assoc.main.ntu.edu.sg

# "entra-id" sends the ID token, whose `aud` is the bare client ID — which is
# what dev's ENTRA_AUDIENCE is set to (lambda/.env.deployment:5). Do not switch
# to "entra" without exposing access_as_user on the registration and changing
# ENTRA_AUDIENCE in both dev backends at the same time.
VITE_API_AUTH_MODE=entra-id

# Deliberately blank, as on staging: runtimeConfig.js turns empty values into
# RELATIVE paths, so the app talks to whichever distribution served it. That
# keeps one artifact valid on both the dist-gi and dist-chatbot prefixes, and
# avoids inheriting .env's doovx82fh9tfs pin — the wrong distribution for dev.
VITE_API_BASE_URL=
VITE_GPU_WORKER_URL=
VITE_LIVE_GATEWAY_URL=

# Both GI environments load the same saved `deanvoice-v1` profile directly.
# This no longer depends on the mutable backend-wide active profile, so another
# dev tool selecting a voice cannot change or block the lesson voice.
VITE_GI_VOICE_PROFILE_ID=deanvoice-v1

# Reports lesson video position to the live gateway so a student can ask "what
# does she mean here?" without naming a timestamp. Older gateways ignore it.
VITE_GI_VIDEO_POSITION=true
