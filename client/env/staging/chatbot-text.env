# Staging "chatbot" kiosk UI (Live Voice Chat + typed questions) on its own
# CloudFront distribution, alongside the gi build on d25sg72wp8oj5g.
#
# Origin-agnostic on purpose — every URL below is deliberately blank so
# runtimeConfig.js emits bare paths. /api/* then resolves against whichever
# distribution served the page, and the /api/live/chat/realtime socket falls
# back to window.location.origin. Pinning these to a CloudFront domain (as
# client/env/staging/chatbot.env does) would make this build call the OTHER
# distribution's API cross-origin, which needs a Lambda CORS_ORIGIN entry it
# does not have.
VITE_APP_MODE=chatbot
VITE_APP_BASENAME=/
VITE_API_BASE_URL=
VITE_GPU_WORKER_URL=
VITE_LIVE_GATEWAY_URL=

# Faculty uses the same multi-tenant Microsoft app registration as lectures,
# but only NTU staff/associate accounts may pass this client-side gate. The
# gateway and Lambda independently enforce the same faculty-only policy.
VITE_AUTH_ENABLED=true
VITE_AUTH_MODE=msal
VITE_ENTRA_CLIENT_ID=9b5c52c0-5f02-4dbf-83ac-c68d246abc68
VITE_ENTRA_TENANT_AUTHORITY=https://login.microsoftonline.com/common
VITE_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,assoc.main.ntu.edu.sg
VITE_API_AUTH_MODE=entra-id

# Staging's saved profile is `deanvoice-v1`; dev's is `DeanVoice`. Getting this
# wrong makes the kiosk sit at "Select a voice model above" forever.
VITE_CHATBOT_VOICE_PROFILE_ID=deanvoice-v1

# Where the "please train your voice" empty state sends a lecturer who has no
# voice profile yet. Blank drops the link rather than guessing a host.
VITE_TRAINING_APP_URL=https://d1qh0ebsvevhy3.cloudfront.net
