# Staging override for the gi (GI-bleeding lesson) build.
#
# deploy-client.ps1 maps `-Mode chatbot` through `chatbotBuildMode: "gi"`, then
# copies this file to client/.env.gi.local before running `npm run build:gi`.
# Without this file the build silently falls back to .env.gi + .env, which pins
# VITE_GPU_WORKER_URL / VITE_LIVE_GATEWAY_URL to doovx82fh9tfs.cloudfront.net —
# the wrong distribution for staging.
VITE_APP_MODE=gi
VITE_APP_BASENAME=/

# The staging CloudFront lesson site is gated behind NTU Microsoft sign-in.
# Set this to false to return the site to public access; the rest of the
# VITE_ENTRA_* block below is inert while it is false.
VITE_GI_AUTH_ENABLED=true

# "mock" (the config.js default) accepts a localStorage flag instead of a real
# identity provider — it must be "msal" for the Entra app registration below to
# be used at all.
VITE_AUTH_MODE=msal

# NTU tenant app registration (public SPA client: auth-code + PKCE, no secret).
VITE_ENTRA_CLIENT_ID=9b5c52c0-5f02-4dbf-83ac-c68d246abc68

# Pinned to the NTU tenant. config.js otherwise defaults to the /common
# authority, which would accept sign-ins from any Microsoft tenant.
VITE_ENTRA_TENANT_AUTHORITY=https://login.microsoftonline.com/45e82b6b-5ac4-41a7-a36f-e702e5e3a355

# msalClient.js rejects any signed-in account whose username does not end in one
# of these, plus #ext# guests and personal Microsoft accounts.
VITE_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,student.main.ntu.edu.sg,assoc.main.ntu.edu.sg

# VITE_ENTRA_REDIRECT_URI is deliberately unset: config.js falls back to
# window.location.origin, which keeps this build origin-agnostic like the URLs
# below. The app registration must list that origin as an *SPA* redirect URI
# (https://d25sg72wp8oj5g.cloudfront.net for staging, http://localhost:5173 for
# local dev). Registering it under the "Web" platform instead fails at token
# redemption with AADSTS9002326.

# Turns the sign-in from a frontend gate into a backend-verified identity.
#
# "entra" makes msalClient.shouldAttachApiAccessToken() true, which does two
# things at once, on purpose: httpClient.js attaches a bearer token to Lambda
# calls, and useLiveSpeech.js sends `session.auth` as the live socket's first
# frame. The socket and the REST client must agree on whether this build
# authenticates — one without the other is how you get a chat that connects but
# stores nothing, or a token the gateway rejects.
#
# The scope is the app ID URI exposed on the registration, not the bare client
# ID: the gateway and Lambda both check `aud` against api://<clientId>, and a
# token minted for the bare client ID fails that check. Setting either of these
# without the other leaves the token unattached — shouldAttachApiAccessToken()
# requires both.
#
# Both are inert unless VITE_AUTH_MODE=msal above.
VITE_API_AUTH_MODE=entra
VITE_ENTRA_API_SCOPE=api://9b5c52c0-5f02-4dbf-83ac-c68d246abc68/access_as_user

# Deliberately blank, unlike the per-app staging envs that hardcode a
# distribution. runtimeConfig.js turns empty values into RELATIVE paths, so the
# app talks to whatever CloudFront distribution served it: /api/* reaches the
# Lambda origin and the /api/live/chat/realtime socket reaches the ALB origin via
# window.location.origin. That keeps this build origin-agnostic — the same
# artifact works whether it is served from the dist-gi or dist-chatbot prefix,
# and no edit is needed here if the distribution changes.
VITE_API_BASE_URL=
VITE_GPU_WORKER_URL=
VITE_LIVE_GATEWAY_URL=

# Staging's cloned voice is registered as deanvoice-v1 (dev uses DeanVoice).
# This verifies the active profile rather than selecting one: if the shared
# backend's active voice is not this, the chat refuses to start instead of
# speaking in the wrong voice. Override per-session with ?voice=<name>.
VITE_GI_VOICE_PROFILE_ID=deanvoice-v1

# Reports lesson video position to the live gateway so a student can ask "what
# does she mean here?" without naming a timestamp. Older gateways ignore it.
VITE_GI_VIDEO_POSITION=true
